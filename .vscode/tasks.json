{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build current C++ file",
      "type": "process",
      "command": "D:\\w64devkit-x64\\w64devkit\\bin\\g++.exe",
      "args": [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "D:\\w64devkit-x64\\w64devkit\\bin\\vscode-current-cpp.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "build current C file",
      "type": "process",
      "command": "D:\\w64devkit-x64\\w64devkit\\bin\\gcc.exe",
      "args": [
        "-std=c17",
        "-O2",
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "D:\\w64devkit-x64\\w64devkit\\bin\\vscode-current-c.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
